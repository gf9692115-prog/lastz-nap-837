# Public values baked into the GitHub Pages static build.
# Use only the anon key or publishable key here. Never put a service-role
# or secret key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: defaults to <SUPABASE_URL>/functions/v1/upload-report
NEXT_PUBLIC_UPLOAD_FUNCTION_URL=

# Optional local/deployment values.
# Leave NEXT_PUBLIC_BASE_PATH empty for localhost. The Pages workflow computes
# "/<repository-name>" automatically for project pages.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Edge Function secrets are NOT frontend variables.
# Configure them in Supabase Dashboard -> Edge Functions -> Secrets:
#   DEEPSEEK_API_KEY
#   DEEPSEEK_BASE_URL=https://api.deepseek.com
#   DEEPSEEK_MODEL=deepseek-flash
#   SUPABASE_REPORTS_BUCKET=reports
#   ADMIN_DELETE_TOKEN=<at least 16 chars; use a long random passphrase>
