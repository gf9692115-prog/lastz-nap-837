# Secrets for the upload-report Edge Function.
# Add this file as supabase/functions/.env for local `supabase functions serve`.
# For production, set these in Supabase Dashboard -> Edge Functions -> Secrets.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
SUPABASE_REPORTS_BUCKET=reports
